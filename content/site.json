{
  "texts": {
    "name": "Alëna Sokolova",
    "title": "Alena Sokolova — Contemporary Artist & Painter in Boston",
    "metaDescription": "Alena Sokolova is a Boston-based painter bridging classical oil painting with post-digital aesthetics: botanical still life, metallic leaf, and augmented reality.",
    "intro": "Alena Sokolova is a Boston-based painter who bridges classical oil painting with post-digital aesthetics — botanical still life, metallic leaf, and augmented reality.",
    "about": "Alena Sokolova is a contemporary painter based in Boston, originally from Siberia, Russia. Her practice bridges classical oil painting with post-digital aesthetics, examining the tension between material tradition and contemporary visual culture.\n\nThrough detailed studies of botanical forms — from full bloom to decay — she explores transformation, impermanence, and the fragile equilibrium between states. She works with glazing, mixed media, and metallic leaf, and in selected works extends the painted surface into augmented reality.\n\nA member of SoWa Artists Studios in Boston, she has exhibited in the United States and internationally. Her works are held in private collections across the US, UK, Russia, and Europe.",
    "email": "sokolovuska@gmail.com",
    "instagram": "https://www.instagram.com/s.alyona.art/",
    "facebook": "https://www.facebook.com/profile.php?id=100068643016046",
    "artfinder": "http://www.artfinder.com/artist/artsokolova/",
    "cvUrl": "https://drive.google.com/file/d/1bcHj1ULHfJe-3IpW7pVTkixkhhEs61eO/view?usp=sharing",
    "heroImage": "hero-alena",
    "aboutImage": "about-alena",
    "arImage": "ar-composition"
  },
  "series": [
    {
      "id": "twelve-months",
      "name": "Twelve Months",
      "order": 1,
      "ar": false,
      "description": "A visual calendar in which each painting embodies a month through its symbolic flower and ruling planet. A single black line runs through all twelve canvases, an unseen force connecting them, while graphic signs of code and repetition create a sense of ordered chaos."
    },
    {
      "id": "digital-flora",
      "name": "Digital Flora",
      "order": 2,
      "ar": false,
      "description": "The classical floral still life placed in dialogue with the visual language of the digital age. Hyperrealistic oil painting meets luminous lines, layered textures, and saturated color, asking where the real ends and the constructed begins."
    },
    {
      "id": "fibonaccis-secret-garden",
      "name": "Fibonacci's Secret Garden",
      "order": 3,
      "ar": false,
      "description": ""
    },
    {
      "id": "the-babylonian-gardens",
      "name": "The Babylonian Gardens",
      "order": 4,
      "ar": false,
      "description": ""
    },
    {
      "id": "digital-flora-ar-series",
      "name": "Digital Flora — AR Series",
      "order": 5,
      "ar": true,
      "description": "Butterflies, ladybugs, dragonflies, and bumblebees, painted in oil in the tradition of the Old Dutch masters, come to life in Augmented Reality and continue to exist in digital space."
    },
    {
      "id": "balance",
      "name": "Balance",
      "order": 6,
      "ar": true,
      "description": "A visual metaphor for the search for stability amid the emotional and informational overload of contemporary life. Flowers, butterflies, droplets, and scales float against a black ground that recalls both a screen and the void, and the compositions unfold further in augmented reality."
    },
    {
      "id": "memories",
      "name": "Memories",
      "order": 7,
      "ar": false,
      "description": "Cyanotype, one of the earliest photographic processes, forms an unstable, light-touched imprint of memory; over it, flowers are painted in oil with the focus of classical still life. A circle of metallic leaf shifts with the viewer's gaze, adding a third layer of time.",
      "large": true
    }
  ],
